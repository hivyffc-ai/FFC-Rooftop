---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import FFCServiceCategoryPage from '@/components/ffc-service-category-page.astro';
import FFCAreaPage from '@/components/ffc-area-page.astro';
import FFCKeywordPage from '@/components/ffc-keyword-page.astro';
import {
  serviceCategories,
  vadodaraAreas,
  getServiceBySlug,
  getAreaBySlug,
  siteConfig,
  packages,
  type ServiceCategory,
  type ServiceKeyword,
} from '@/lib/ffc-config';

const startingPrice = Math.min(...packages.map((p) => p.price));

export const prerender = true;

export function getStaticPaths() {
  const paths: { params: { slug: string } }[] = [];

  for (const service of serviceCategories) {
    paths.push({ params: { slug: service.slug } });
  }

  for (const area of vadodaraAreas) {
    paths.push({ params: { slug: area.slug } });
  }

  for (const service of serviceCategories) {
    for (const keyword of service.keywords) {
      paths.push({ params: { slug: keyword.slug } });
    }
  }

  return paths;
}

function findKeywordBySlug(
  slug: string,
): { keyword: ServiceKeyword; service: ServiceCategory } | undefined {
  for (const service of serviceCategories) {
    const keyword = service.keywords.find((k) => k.slug === slug);
    if (keyword) return { keyword, service };
  }
  return undefined;
}

const { slug } = Astro.params as { slug: string };

const serviceCategory = getServiceBySlug(slug);
const area = getAreaBySlug(slug);
const keywordData = findKeywordBySlug(slug);

if (!serviceCategory && !area && !keywordData) {
  return Astro.redirect('/404', 302);
}

const SITE_URL = siteConfig.website;

let title = '';
let description = '';
let keywords: string[] = [];
let pageName = '';

if (serviceCategory) {
  title = serviceCategory.metaTitle;
  description = serviceCategory.metaDescription;
  keywords = [
    serviceCategory.name.toLowerCase(),
    `${serviceCategory.name.toLowerCase()} vadodara`,
    `${serviceCategory.name.toLowerCase()} for couples`,
    `best ${serviceCategory.name.toLowerCase()} vadodara`,
    `friends factory cafe ${serviceCategory.name.toLowerCase()}`,
  ];
} else if (area) {
  title = `Romantic Celebration in ${area.name}, Vadodara | Friends Factory Cafe`;
  description = `Book romantic celebrations, candlelight dinners, birthday surprises & anniversary parties in ${area.name}, Vadodara at Friends Factory Cafe. Private rooftop venue with stunning setups. Call +91 74878 88730.`;
  keywords = [
    `romantic celebration ${area.name}`,
    `candlelight dinner ${area.name}`,
    `birthday surprise ${area.name}`,
    `friends factory cafe ${area.name}`,
    `couple cafe ${area.name} vadodara`,
    `anniversary dinner ${area.name}`,
    `romantic restaurant ${area.name}`,
    `private dining ${area.name}`,
  ];
} else if (keywordData) {
  title = keywordData.keyword.metaTitle;
  description = keywordData.keyword.metaDescription;
  keywords = [
    keywordData.keyword.title.toLowerCase(),
    `${keywordData.keyword.title.toLowerCase()} vadodara`,
    `${keywordData.service.name.toLowerCase()} vadodara`,
    `friends factory cafe ${keywordData.keyword.title.toLowerCase()}`,
    `best ${keywordData.keyword.title.toLowerCase()} vadodara`,
    `${keywordData.service.name.toLowerCase()} near me vadodara`,
  ];
}

if (serviceCategory) pageName = serviceCategory.name;
else if (area) pageName = `Celebrations in ${area.name}`;
else if (keywordData) pageName = keywordData.keyword.title;

const canonicalUrl = `${SITE_URL}/${slug}`;

// GEO: concrete, extractable facts (price, provider, area served) for this
// page's specific service - not the sitewide LocalBusiness schema alone.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: pageName,
  description,
  provider: {
    '@type': 'LocalBusiness',
    name: siteConfig.name,
    telephone: siteConfig.phone,
    address: siteConfig.address,
  },
  areaServed: area ? area.name : siteConfig.city,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'INR',
    price: startingPrice,
    availability: 'https://schema.org/InStock',
    url: canonicalUrl,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    ...(keywordData
      ? [
          { '@type': 'ListItem', position: 2, name: keywordData.service.name, item: `${SITE_URL}/${keywordData.service.slug}` },
          { '@type': 'ListItem', position: 3, name: pageName, item: canonicalUrl },
        ]
      : [{ '@type': 'ListItem', position: 2, name: pageName, item: canonicalUrl }]),
  ],
};
---
<BaseLayout title={title} description={description} keywords={keywords} canonicalPath={`/${slug}`} extraJsonLd={[serviceSchema, breadcrumbSchema]}>
  <Header />
  {serviceCategory && <FFCServiceCategoryPage service={serviceCategory} />}
  {area && <FFCAreaPage area={area} />}
  {keywordData && <FFCKeywordPage service={keywordData.service} keyword={keywordData.keyword} />}
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
