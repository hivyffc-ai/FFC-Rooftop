---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import FFCBlogPostPage from '@/components/ffc-blog-post-page.astro';
import { getAllBlogPosts, getBlogBySlug } from '@/lib/ffc-config';

export function getStaticPaths() {
  return getAllBlogPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

if (!post) {
  return Astro.redirect('/blog', 302);
}

const SITE_URL = 'https://friendsfactorycafe.com';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "image": `${SITE_URL}${post.coverImage}`,
  "url": `${SITE_URL}/blog/${post.slug}`,
  "datePublished": post.publishedAt,
  "dateModified": post.publishedAt,
  "author": {
    "@type": "Organization",
    "@id": `${SITE_URL}/#business`,
    "name": "Friends Factory Cafe",
    "url": SITE_URL
  },
  "publisher": {
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    "name": "Friends Factory Cafe",
    "logo": {
      "@type": "ImageObject",
      "url": `${SITE_URL}/images/gallery/friends-factory-cafe-logo-1.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/${post.slug}`
  },
  "keywords": post.tags.join(", "),
  "articleSection": post.category,
  "inLanguage": "en-IN",
  "about": {
    "@type": "LocalBusiness",
    "@id": `${SITE_URL}/#business`,
    "name": "Friends Factory Cafe"
  }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${SITE_URL}/blog` },
    { "@type": "ListItem", "position": 3, "name": post.title, "item": `${SITE_URL}/blog/${post.slug}` }
  ]
};
---
<BaseLayout
  title={post.metaTitle}
  description={post.metaDescription}
  keywords={[...post.tags, "vadodara", "friends factory cafe", "romantic celebration"]}
  canonicalPath={`/blog/${post.slug}`}
  ogImage={post.coverImage}
  ogImageAlt={`${post.title} — Friends Factory Cafe Blog`}
  noTemplate={false}
  extraJsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <FFCBlogPostPage post={post} />
</BaseLayout>
