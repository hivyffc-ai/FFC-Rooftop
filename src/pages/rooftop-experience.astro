---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import BookNowButton from '@/components/BookNowButton.astro';
import { packages, siteConfig } from '@/lib/ffc-config';

const rooftopPackages = packages.filter((p) => p.slug.includes('rooftop'));
const allPackages = packages;

const faqsJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the rooftop experience at Friends Factory Cafe Vadodara?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The rooftop experience at Friends Factory Cafe is a 3-hour exclusive private celebration on our open-sky rooftop in Gotri, Vadodara. It includes romantic candlelight setup, welcome drink, decor, soft music, and panoramic city views. Packages start at ₹4,700."
      }
    },
    {
      "@type": "Question",
      "name": "How many people can use the rooftop at a time?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The rooftop is designed for intimate celebrations — typically 2-3 people. It is 100% private with no other guests during your booking slot."
      }
    },
    {
      "@type": "Question",
      "name": "What occasions are best suited for the rooftop experience?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The rooftop at Friends Factory Cafe is perfect for anniversary dinners, romantic proposals, candlelight dates, birthday surprises, pre-wedding photoshoots, and surprise date nights in Vadodara."
      }
    },
    {
      "@type": "Question",
      "name": "What time slots are available for rooftop celebrations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rooftop slots are available from 6 PM to 11 PM. Evening slots (7 PM–10 PM) are most popular and book quickly — advance booking recommended, especially on weekends and holidays."
      }
    },
    {
      "@type": "Question",
      "name": "Is food included in the rooftop experience package?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, all rooftop packages include welcome drinks and curated snacks. Celebration cake is included in the premium packages (Setups 1–3, priced from ₹6,000) and available at ₹500 extra in other packages."
      }
    }
  ]
};
---
<BaseLayout
  title="Rooftop Dining Experience Vadodara | Private Rooftop Celebrations | Friends Factory Cafe"
  description="Experience Vadodara's most romantic private rooftop at Friends Factory Cafe, Gotri. Exclusive 3-hour candlelight setups, panoramic city views, welcome drinks & decor. Perfect for proposals, anniversaries & date nights. Starting ₹4,700. Book: +91 74878 88730."
  keywords={["rooftop experience vadodara", "rooftop dinner vadodara", "private rooftop celebration vadodara", "rooftop date night vadodara", "romantic rooftop gotri vadodara", "rooftop proposal vadodara", "rooftop anniversary dinner vadodara", "friends factory cafe rooftop"]}
  canonicalPath="/rooftop-experience"
  ogImageAlt="Private Rooftop Dining Experience at Friends Factory Cafe Vadodara"
  noTemplate={false}
  extraJsonLd={faqsJsonLd}
>
  <div class="min-h-screen bg-white">
    <Header />

    <!-- Hero -->
    <section class="bg-gradient-to-br from-amber-700 via-orange-600 to-amber-800 text-white py-20">
      <div class="container mx-auto px-4 text-center max-w-4xl">
        <p class="text-amber-200 font-medium mb-4 uppercase tracking-wider text-sm">Vadodara's Most Romantic Venue</p>
        <h1 class="text-4xl md:text-6xl font-bold font-serif mb-6 leading-tight">
          Private Rooftop Experience
        </h1>
        <p class="text-xl text-white/90 mb-4 max-w-2xl mx-auto">
          An exclusive 3-hour celebration under the open sky — candlelight, city views, and zero interruptions.
          100% private. Starting ₹4,700.
        </p>
        <div class="flex flex-wrap justify-center gap-4 text-sm text-amber-100 mb-8">
          <span>📍 Gotri, Vadodara</span>
          <span>⏰ Evening slots: 6 PM–11 PM</span>
          <span>👫 2–3 guests max</span>
          <span>🍰 Cake & drinks included</span>
        </div>
        <BookNowButton size="lg" text="Book Your Rooftop Slot" />
      </div>
    </section>

    <!-- Why Rooftop -->
    <section class="py-16 bg-amber-50">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl font-bold font-serif text-center mb-10">Why Choose Our Rooftop?</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            { emoji: "🌆", title: "Panoramic City Views", desc: "Vadodara's skyline as your backdrop — the most Instagram-worthy setting in the city." },
            { emoji: "🔒", title: "100% Private", desc: "You get the entire rooftop. No other guests, no strangers. Just you and your loved one." },
            { emoji: "🕯️", title: "Fully Decorated", desc: "Candles, fairy lights, rose petals, balloons — set up fresh before you arrive." },
            { emoji: "🥂", title: "Welcome Drinks", desc: "Every package includes refreshments. Packages 1–3 also include a free celebration cake." },
            { emoji: "🎶", title: "Romantic Music", desc: "Soft background music throughout your 3-hour exclusive slot." },
            { emoji: "📸", title: "Photo-Ready Setup", desc: "Every corner of our rooftop is designed to look beautiful in photos." },
          ].map((item) => (
            <div class="text-center bg-white rounded-xl p-6 shadow-sm">
              <div class="text-4xl mb-3">{item.emoji}</div>
              <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Packages -->
    <section class="py-16">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-3xl font-bold font-serif text-center mb-4">Rooftop Packages</h2>
        <p class="text-gray-600 text-center mb-10">Choose your setup — every package is private, decorated, and unforgettable</p>
        <div class="grid md:grid-cols-2 gap-6">
          {allPackages.map((pkg) => (
            <a href={`/packages/${pkg.slug}`} class="group flex gap-4 bg-white border border-amber-100 rounded-xl p-4 hover:shadow-lg transition-all">
              <img src={pkg.thumbnail} alt={`${pkg.name} - Romantic Package at Friends Factory Cafe Vadodara`} class="w-24 h-24 object-cover rounded-lg flex-shrink-0" loading="lazy" />
              <div>
                <h3 class="font-bold text-gray-900 group-hover:text-amber-600 transition-colors mb-1">{pkg.name}</h3>
                <p class="text-gray-500 text-sm mb-2 line-clamp-2">{pkg.shortDescription}</p>
                <p class="text-amber-600 font-bold">₹{pkg.price.toLocaleString('en-IN')}</p>
              </div>
            </a>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/packages" class="inline-flex items-center gap-2 bg-amber-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-amber-700 transition-colors">
            View All 8 Packages →
          </a>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl font-bold font-serif text-center mb-10">Rooftop Experience FAQs</h2>
        <div class="space-y-4">
          {[
            { q: "What is the rooftop experience at Friends Factory Cafe Vadodara?", a: "The rooftop experience is a 3-hour exclusive private celebration on our open-sky rooftop in Gotri, Vadodara. It includes romantic candlelight setup, welcome drink, decor, soft music, and panoramic city views. Packages start at ₹4,700." },
            { q: "How many people can use the rooftop at a time?", a: "The rooftop is designed for intimate celebrations — typically 2–3 people. It is 100% private with no other guests during your booking slot." },
            { q: "What occasions are best suited for the rooftop experience?", a: "Anniversaries, romantic proposals, candlelight dates, birthday surprises, pre-wedding photoshoots, and surprise date nights in Vadodara." },
            { q: "What time slots are available for rooftop celebrations?", a: "Evening slots from 6 PM to 11 PM. The 7 PM–10 PM slots are most popular — advance booking recommended, especially on weekends." },
            { q: "Is food included in the rooftop package?", a: "Yes, all rooftop packages include welcome drinks and curated snacks. Celebration cake is included in Setups 1–3 (from ₹6,000) and available at ₹500 extra in other packages." },
          ].map((item) => (
            <div class="bg-white rounded-xl p-5 shadow-sm">
              <h3 class="font-bold text-gray-900 mb-2">{item.q}</h3>
              <p class="text-gray-600 text-sm">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Footer />
    <WhatsAppFloat />
  </div>
</BaseLayout>
